# Copy to .env and adjust. Never commit .env.
TRIAGE_CLASSIFIER=rules
# For an LLM classifier, any OpenAI-compatible endpoint works (Ollama shown):
# TRIAGE_CLASSIFIER=llm
# TRIAGE_LLM_BASE_URL=http://localhost:11434/v1
# TRIAGE_LLM_MODEL=qwen2.5:3b
# TRIAGE_LLM_API_KEY=
TRIAGE_REVIEW_THRESHOLD=0.7
TRIAGE_TRACE_EXPORTER=none
# With TRIAGE_TRACE_EXPORTER=otlp and `docker compose up -d`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
